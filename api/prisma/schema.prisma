generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  PILOTO
  ADMIN
}

// Fase beta: toda cuenta nueva espera la aprobación de un administrador.
enum Estado {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum Plan {
  GRATIS
  PLUS
  PRO
}

enum TipoContenido {
  MATERIAL
  BENEFICIO
}

model Usuario {
  id     String @id @default(cuid())
  // Los pilotos siempre tienen correo; un administrador puede tener solo
  // nombre de usuario. Se inicia sesión con cualquiera de los dos.
  email   String? @unique
  // Sin restricción única en la base: la API impide repetirlo (ver
  // routes/admin.js) y así agregar la columna no exige aceptar pérdida de datos.
  usuario String?
  nombre  String?
  hash   String
  rol    Rol    @default(PILOTO)
  estado Estado @default(PENDIENTE)

  // Plan que eligió el propio piloto (simulado: no hay cobro).
  plan Plan @default(GRATIS)
  // Plan regalado por Rubus Racing (fidelización de alumnos). Si está vigente
  // y es superior al elegido, manda él. Sin fecha de término no caduca.
  cortesia      Plan?
  cortesiaHasta DateTime? @db.Date

  // Deportes que practica (ids de DEPORTES en web/campos.js).
  deportes String[] @default([])
  // Los planes Gratis y Plus ven anuncios; el Pro solo si los activa.
  anunciosPro Boolean @default(false)

  // Aceptación de términos: versión, fecha, mailing, datos del apoderado.
  consentimiento Json?

  creado   DateTime  @default(now())
  aprobado DateTime?

  ficha   Ficha?
  accesos Acceso[]

  @@index([usuario])
}

// Todo lo que el piloto registra en la app (perfil, motos, sesiones, foto,
// imágenes de pistas) vive en un único documento. `version` evita que dos
// dispositivos se pisen los cambios sin saberlo.
model Ficha {
  usuarioId   String   @id
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  datos       Json
  version     Int      @default(0)
  actualizada DateTime @updatedAt
}

// Sesión de inicio de sesión. Se guarda el hash del token, nunca el token.
model Acceso {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expira    DateTime
  creado    DateTime @default(now())

  @@index([usuarioId])
}

// Módulo provisorio de material educativo y beneficios del plan Pro. Más
// adelante el material pasará a una plataforma propia.
model Contenido {
  id          String        @id @default(cuid())
  tipo        TipoContenido @default(MATERIAL)
  titulo      String
  // Agrupa el material en la app (por ejemplo «Técnica de manejo»).
  categoria   String?
  resumen     String?
  cuerpo      String?       @db.Text
  enlace      String?
  publicado   Boolean       @default(true)
  orden       Int           @default(0)
  creado      DateTime      @default(now())
  actualizado DateTime      @updatedAt
}

// Publicidad de sponsors para los planes Gratis y Plus (y Pro si la activa).
model Anuncio {
  id          String    @id @default(cuid())
  sponsor     String
  titulo      String
  texto       String?
  // Banner en JPEG (data URL), ya reducido por el panel.
  imagen      String?   @db.Text
  enlace      String?
  // Dónde aparece: INICIO, SESIONES, DATOS. Deportes vacíos = todos.
  lugares     String[]  @default([])
  deportes    String[]  @default([])
  desde       DateTime? @db.Date
  hasta       DateTime? @db.Date
  activo      Boolean   @default(true)
  // Peso relativo cuando varios anuncios compiten por el mismo espacio.
  peso        Int       @default(1)
  impresiones Int       @default(0)
  clics       Int       @default(0)
  creado      DateTime  @default(now())
  actualizado DateTime  @updatedAt
}

// Catálogo de circuitos. Los pilotos eligen de aquí en vez de escribir el
// nombre; si falta uno lo proponen (PROPUESTO, visible solo para quien lo
// propuso) y el administrador lo aprueba, lo fusiona con otro o lo rechaza.
enum EstadoCircuito {
  PROPUESTO
  APROBADO
  RECHAZADO
}

model Circuito {
  id           String         @id @default(cuid())
  nombre       String
  // Nombre normalizado (minúsculas, sin espacios extremos) para evitar duplicados.
  clave        String
  ciudad       String?
  region       String?
  pais         String?        @default("Chile")
  deportes     String[]       @default([])
  trazados     String[]       @default([])
  longitud     Int?
  estado       EstadoCircuito @default(APROBADO)
  propuestoPor String?
  nota         String?
  imagenes     CircuitoImagen[]
  creado       DateTime       @default(now())
  actualizado  DateTime       @updatedAt

  @@index([clave])
  @@index([estado])
}

// Fotos de un circuito (máximo 5): una aérea principal y otras de apoyo. Se
// guardan como binario y se sirven en /api/img/circuito/:id con caché larga.
model CircuitoImagen {
  id         String   @id @default(cuid())
  circuitoId String
  circuito   Circuito @relation(fields: [circuitoId], references: [id], onDelete: Cascade)
  datos      Bytes
  tipo       String   @default("image/jpeg")
  principal  Boolean  @default(false)
  orden      Int      @default(0)
  creado     DateTime @default(now())

  @@index([circuitoId])
}

// Premios y descuentos que se desbloquean al llegar a un nivel. Solo para
// cuentas de pago (Plus y Pro).
model Recompensa {
  id          String   @id @default(cuid())
  nivel       Int
  titulo      String
  descripcion String?
  sponsor     String?
  // Código o instrucciones: solo se entregan a quien ya desbloqueó el nivel.
  codigo      String?
  enlace      String?
  activo      Boolean  @default(true)
  orden       Int      @default(0)
  creado      DateTime @default(now())
  actualizado DateTime @updatedAt
}

// Ajustes de la plataforma editables desde el panel (por ejemplo, los niveles y
// las reglas de puntos de las recompensas), guardados como JSON por clave.
model Ajuste {
  clave       String   @id
  valor       Json
  actualizado DateTime @updatedAt
}
